# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_marketing_dev
# True: create missing tables on startup (dev). In production set False and
# run `flask --app wsgi db upgrade` (Alembic migrations in migrations/).
AUTO_CREATE_TABLES=True

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Email Settings
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_TLS=True
SMTP_TIMEOUT=30

# Application Settings
MAX_EMAIL_BATCH_SIZE=100
QUEUE_PROCESSING_INTERVAL=10
MAX_RETRY_ATTEMPTS=3
DAILY_EMAIL_LIMIT=10000
MAX_EMAILS_PER_MINUTE=60
MAX_SOFT_BOUNCES=3
EMAIL_LOG_RETENTION_DAYS=365

# Background scheduler. Run it in exactly ONE process: either here (single
# web process) or via `python worker.py` with this set to False for gunicorn.
ENABLE_SCHEDULER=True

# Tracking / public links
ENABLE_TRACKING=True
# Public base URL used in tracking pixels, click and unsubscribe links
TRACKING_DOMAIN=http://localhost:5000

# Set to 1 when running behind nginx (real client IP + https from X-Forwarded-*)
TRUSTED_PROXIES=0

# Server owner(s) who may download full backups (comma separated).
# Empty = the first account created on the server.
ADMIN_EMAILS=
# Directory with readable DKIM key copies to include in backups (set by deploy/install.sh)
DKIM_BACKUP_DIR=

# Auth endpoint rate limit (requests per minute per IP)
AUTH_RATE_LIMIT_PER_MINUTE=20
